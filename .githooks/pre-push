#!/bin/sh
#
# Refuse a push that would leave a lint error or a stale document on a branch.
# All four checks are clean and together take about eleven seconds; run
# `git push --no-verify` on the occasions when that is the wrong trade.

set -e

printf 'pattern-builder: checking before push\n'

checked=''

# Each toolchain is looked for separately, so a checkout that installed one of
# them is not waved past its checks because the other is missing.
if [ -d node_modules ]; then
	npm run --silent lint:js
	npm run --silent lint:css
	npm run --silent check:docs
	checked='js, css, docs'
fi

# phpcs finds phpcs.xml.dist on its own, which is the standard this repository
# is linted against.
if [ -x vendor/bin/phpcs ]; then
	vendor/bin/phpcs -q
	checked="${checked:+$checked, }php"
fi

if [ -z "$checked" ]; then
	printf 'pattern-builder: neither node_modules nor vendor installed, nothing checked.\n'
else
	printf 'pattern-builder: ok (%s)\n' "$checked"
fi
