{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "560px",
			"wideSize": "900px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#fbf7f0" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1c1a17" },
				{ "slug": "primary", "name": "Primary", "color": "#8a5a2b" },
				{ "slug": "secondary", "name": "Secondary", "color": "#5c6b52" },
				{ "slug": "accent", "name": "Accent", "color": "#b3452f" }
			],
			"gradients": [
				{
					"slug": "sunrise",
					"name": "Sunrise",
					"gradient": "linear-gradient(160deg, #fbf7f0 0%, #e8d5bc 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.15rem" },
				{ "slug": "large", "name": "Large", "size": "1.6rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.4rem" }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "'Helvetica Neue', Helvetica, Arial, sans-serif"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.75rem" },
				{ "slug": "40", "name": "2", "size": "1.25rem" },
				{ "slug": "60", "name": "3", "size": "2rem" },
				{ "slug": "80", "name": "4", "size": "4rem" }
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "800",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "0" },
				"typography": { "fontWeight": "700" }
			}
		}
	}
}
