{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "36rem",
			"wideSize": "58rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#fbf7f0" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1c1a17" },

				{ "slug": "surface", "name": "Surface", "color": "#f2ebdf" },
				{ "slug": "surface-variant", "name": "Surface Variant", "color": "#e6dccb" },
				{ "slug": "text-muted", "name": "Text Muted", "color": "#6b6355" },
				{ "slug": "primary", "name": "Primary", "color": "#8a5a2b" },
				{ "slug": "primary-hover", "name": "Primary Hover", "color": "#6d4620" },
				{ "slug": "accent", "name": "Accent", "color": "#b3452f" },
				{ "slug": "hairline", "name": "Hairline", "color": "#ddd2bd" }
			],
			"gradients": [
				{
					"slug": "sunrise",
					"name": "Sunrise",
					"gradient": "linear-gradient(160deg, #fbf7f0 0%, #e8d5bc 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.15rem" },
				{ "slug": "large", "name": "Large", "size": "1.6rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.4rem" },
				{ "slug": "xx-large", "name": "Extra Extra Large", "size": "3.6rem" }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "'Helvetica Neue', Helvetica, Arial, sans-serif"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "Extra Small", "size": "0.5rem" },
				{ "slug": "30", "name": "Small", "size": "0.75rem" },
				{ "slug": "40", "name": "Base", "size": "1.25rem" },
				{ "slug": "50", "name": "Medium", "size": "2rem" },
				{ "slug": "60", "name": "Large", "size": "3rem" },
				{ "slug": "70", "name": "Extra Large", "size": "4.5rem" },
				{ "slug": "80", "name": "2X Large", "size": "7rem" }
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0px",
				"bottom": "0px",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "800",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary-hover)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "0" },
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)"
					}
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--primary-hover)" }
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "background": "var(--wp--preset--color--hairline)" }
			},
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			}
		}
	}
}
